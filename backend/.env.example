# Application
APP_ENV=development
APP_TIMEZONE=Asia/Ho_Chi_Minh
MAX_DAILY_WORK_HOURS=8.0
# Trên ngưỡng này, tính lại CPM được đẩy sang Postgres jobs.
CPM_SYNC_TASK_THRESHOLD=300
CPM_MAX_TASKS=2000
CPM_MAX_DEPENDENCIES=10000
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Host cho TrustedHostMiddleware. "*" chỉ dùng cho development; production phải đặt hostname thật.
ALLOWED_HOSTS=["*"]
# Chỉ bật khi chạy sau reverse proxy có ghi đè X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Database (PostgreSQL async)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_project_management
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0

# Legacy Celery (optional legacy-celery Docker profile only; do not enable on Free)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001"]

# MinIO (S3-compatible)
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ai-project-files
MINIO_USE_SSL=false

# xKiro (mac dinh) - cong AI tuong thich OpenAI, nhieu model mien phi theo tung task
XKIRO_API_KEY=sk-xt-your-xkiro-api-key-here
XKIRO_BASE_URL=https://api.xkiro.com/v1
# Only catalog entries with access_tier=free are used; at most three models per attempt.
XKIRO_FREE_FALLBACK_MODELS=["mistralai/mistral-large-4-0","mistralai/mistral-medium-3.5","qwen/qwen-plus-2025-07-28:free"]
XKIRO_MODEL_PROJECT_GENERATION=deepseek/deepseek-v4-pro-0813
XKIRO_MODEL_DOCUMENT_PARSING=qwen/qwen3-vl-plus:free
XKIRO_MODEL_IMPACT_ANALYSIS=deepseek/deepseek-v4-flash
XKIRO_MODEL_SCHEDULE_OPTIMIZATION=qwen/qwen3.7-max:free
XKIRO_MODEL_RESOURCE_RECOMMENDATION=mistralai/mistral-medium-3.5
XKIRO_MODEL_RISK_ANALYSIS=mistralai/mistral-large-2512
XKIRO_MODEL_CHAT_QUICK=deepseek/deepseek-chat-v3.1

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@projectmanagement.com
EMAIL_FROM_NAME="AI Project Management"
SMTP_STARTTLS=true
SMTP_SSL_TLS=false
SMTP_USE_CREDENTIALS=true
SMTP_VALIDATE_CERTS=true

# Social Login (OAuth 2.0)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google/callback
FRONTEND_URL=http://localhost:3000

# Durable jobs run inside the backend; no worker/Beat process is required.
DEPLOYMENT_PROFILE=local
JOBS_ENABLED=true
JOB_CONCURRENCY=1
JOB_POLL_SECONDS=5
JOB_TIMEOUT_SECONDS=180
JOB_LEASE_SECONDS=240
JOB_MAX_ATTEMPTS=3
AI_DAILY_JOB_LIMIT=20
AI_MAX_PROJECT_TASKS=1000
AI_HTTP_TIMEOUT_SECONDS=90
AI_MAX_OUTPUT_TOKENS=8000
# Local Redis compatibility; Render Free uses database (see ../.env.production.example).
SECURITY_STATE_BACKEND=redis
DATABASE_SSL=false
DATABASE_DISABLE_PREPARED_STATEMENTS=false
CRON_SECRET=
CRON_BATCH_SIZE=20
CRON_CATCHUP_HOURS=12
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
STORAGE_PROVIDER=minio
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ai-project-files
STORAGE_SIGNED_URL_TTL_SECONDS=300
