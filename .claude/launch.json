{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-dev",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "Set-Location frontend; node node_modules/next/dist/bin/next dev"],
      "port": 3000
    },
    {
      "name": "backend-dev",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "Set-Location backend; .venv/Scripts/uvicorn.exe app.main:app --host 0.0.0.0 --port 8000 --reload"],
      "port": 8000
    }
  ]
}
