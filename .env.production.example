# Copy to .env in the repository root on the VM. Never commit the filled file.
APP_DOMAIN=app.example.com
POSTGRES_PASSWORD=replace-with-random-password
SECRET_KEY=replace-with-random-string-of-at-least-32-characters
MINIO_ROOT_USER=replace-with-random-access-key
MINIO_ROOT_PASSWORD=replace-with-random-password
FRONTEND_URL=https://app.example.com
ALLOWED_HOSTS=["app.example.com"]
CORS_ORIGINS=["https://app.example.com"]
TRUST_PROXY_HEADERS=true
NEXT_PUBLIC_API_URL=https://app.example.com/api/v1
NEXT_PUBLIC_WS_URL=wss://app.example.com
XKIRO_API_KEY=replace-with-existing-xkiro-key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.example.com/api/v1/oauth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://app.example.com/api/v1/oauth/facebook/callback
