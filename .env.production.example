# Example only; set real values in Render/Supabase dashboards, never commit .env.
# Backend service (server-only)
APP_ENV=production
DEPLOYMENT_PROFILE=render_free
APP_TIMEZONE=Asia/Ho_Chi_Minh
SECRET_KEY=
CRON_SECRET=
ALLOWED_HOSTS=["YOUR-BACKEND.onrender.com"]
CORS_ORIGINS=["https://YOUR-FRONTEND.onrender.com"]
FRONTEND_URL=https://YOUR-FRONTEND.onrender.com
# IPv4 Session pooler5432 from Supabase Connect. Percent-encode password.
# Prefer Session pooler over Transaction pooler for asyncpg prepared statements.
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT:URL_ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres
DATABASE_SSL=true
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=1
# Security state has an additional reserved pool of one connection (total <=5).
DATABASE_DISABLE_PREPARED_STATEMENTS=false
REDIS_URL=redis://YOUR-RENDER-INTERNAL-REDIS:6379/0
SECURITY_STATE_BACKEND=database
JOBS_ENABLED=true
JOB_CONCURRENCY=1
JOB_POLL_SECONDS=5
JOB_TIMEOUT_SECONDS=180
JOB_LEASE_SECONDS=240
JOB_SHUTDOWN_TIMEOUT_SECONDS=10
CPM_MAX_TASKS=2000
CPM_MAX_DEPENDENCIES=10000
AI_DAILY_JOB_LIMIT=20
AI_MAX_PROJECT_TASKS=1000
AI_HTTP_TIMEOUT_SECONDS=90
AI_MAX_OUTPUT_TOKENS=8000
CRON_BATCH_SIZE=20
CRON_CATCHUP_HOURS=12
EMAIL_PROVIDER=resend
EMAIL_FROM=verified-sender@YOUR-DOMAIN
EMAIL_FROM_NAME=AI Project Management
RESEND_API_KEY=
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ai-project-files
STORAGE_SIGNED_URL_TTL_SECONDS=300
XKIRO_API_KEY=
# Optional Google OAuth. Leave all empty until configured; existing password login stays.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback uses FRONTEND proxy so OAuth state cookie is first-party.
GOOGLE_REDIRECT_URI=https://YOUR-FRONTEND.onrender.com/api/v1/oauth/google/callback

# Frontend service build settings; only origins are public, no keys.
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_WS_URL=wss://YOUR-BACKEND.onrender.com
BACKEND_PROXY_ORIGIN=https://YOUR-BACKEND.onrender.com
